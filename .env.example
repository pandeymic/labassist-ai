# Copy to .env for local development. Never commit .env or real credentials.
APP_ENV=development
LABASSIST_ADMIN_KEY=replace-with-a-long-random-local-secret
PUBLIC_BASE_URL=http://127.0.0.1:8000
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Optional AI integrations. Leave blank for the deterministic demo workflow.
GROQ_API_KEY=
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-latest
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# Optional signed messaging integration.
TWILIO_AUTH_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_WHATSAPP_NUMBER=
